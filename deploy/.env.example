# ================= AgenticOS deploy/.env =================
# Copy this file to deploy/.env and fill values.
# ⚠️ NEVER commit .env, never paste values into chat/logs/memory (Law 7).
#     Variable NAMES below are safe to share; values are not.

# ---- Model providers (locked high models; fill whatever you actually have) ----
# Anthropic: console.anthropic.com -> Settings -> API Keys  (primary: claude-sonnet-4-6, claude-haiku-4-5)
ANTHROPIC_API_KEY=
# MiniMax: platform.minimax.io -> API Keys  (failover + research: MiniMax-M3 1M ctx, MiniMax-M2.7-highspeed)
MINIMAX_API_KEY=
# Google AI Studio (optional, vision group: gemini-2.5-flash)
GEMINI_API_KEY=
# OpenAI (optional — only if you wire codex/openai models later)
OPENAI_API_KEY=

# ---- Your own gateway auth (any strong random string; app talks to LiteLLM with it) ----
# e.g. python -c "import secrets;print('sk-'+secrets.token_hex(16))"
LITELLM_MASTER_KEY=sk-agentos-CHANGE-ME

# ---- Local infra ----
POSTGRES_USER=agentos
POSTGRES_DB=agentos
POSTGRES_PASSWORD=agentos-local-CHANGE-ME
GATEWAY_PORT=8000
TEMPORAL_NAMESPACE=agentos
TEMPORAL_TASK_QUEUE=agentos-main

# ---- Paths (Windows example; forward slashes work in both) ----
AI_SYSTEM_ROOT=D:/AI_SYSTEM

# ---- Ollama local models (free-first fallback; only used with --profile local) ----
OLLAMA_API_BASE=http://host.docker.internal:11434
